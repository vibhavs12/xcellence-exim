RewriteEngine On

# Clean WordPress-era URLs remain canonical. Redirect only the temporary
# redesign preview's .html URLs to those stable paths.
Redirect 301 /about.html /about-us/
Redirect 301 /contact.html /contact-us/
Redirect 301 /rice.html /rice/
Redirect 301 /coffee.html /tea-coffee/
Redirect 301 /spices.html /spices/
Redirect 301 /certificates.html /certificates/
Redirect 301 /sugar.html /sugar-icumsa-45/
Redirect 301 /export-process.html /export-process/
Redirect 301 /privacy.html /privacy/
